# ============================================================================
#  AI Persona — environment variables
#  Copy to `.env.local` (for Next.js) and fill in. Scripts also read `.env.local`.
#  Everything here has a FREE tier. Nothing in this file should be committed.
# ============================================================================

# --- Identity (personalizes prompts + UI) -----------------------------------
PERSONA_NAME="Your Name"
PERSONA_ROLE="AI Engineer Intern candidate at Scaler"
NEXT_PUBLIC_PERSONA_NAME="Your Name"

# --- Embeddings: Google Gemini (FREE tier) ----------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Used for EMBEDDINGS ONLY (gemini-embedding-001); its quota is separate from chat.
GOOGLE_GENERATIVE_AI_API_KEY=""
EMBED_MODEL="gemini-embedding-001"

# --- Chat + voice reasoning + eval judge: Groq (FREE, fast, higher limits) ---
# Get a free key: https://console.groq.com/keys (also paste into Vapi Provider Keys).
GROQ_API_KEY=""
CHAT_MODEL="llama-3.3-70b-versatile"
JUDGE_MODEL="llama-3.3-70b-versatile"

# Optional fallback provider (OpenRouter) — auto fail-over if Groq is down/limited,
# so the app never goes dark during the 7-day live window. Free key:
# https://openrouter.ai/keys . Leave blank for Groq-only.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-oss-120b:free"
OPENROUTER_SITE_URL=""
OPENROUTER_APP_NAME="AI Persona"

# --- GitHub ingestion -------------------------------------------------------
# Whose public repos to ground on. README + repo metadata + recent commits.
GITHUB_USERNAME=""
# Optional classic/fine-grained token: raises rate limit 60->5000/hr and lets
# you include private repos. Scope: public_repo (or repo for private).
GITHUB_TOKEN=""
# Comma-separated repo names to FORCE-include or EXCLUDE (optional).
GITHUB_INCLUDE_ONLY=""
GITHUB_EXCLUDE=""
# Max repos to ingest (most-recently-pushed first).
GITHUB_MAX_REPOS="30"
# Recent commit messages to pull per repo (grounds "commit history" questions).
GITHUB_COMMITS_PER_REPO="30"

# --- Resume -----------------------------------------------------------------
# Drop your resume at data/resume/resume.pdf (PDF or .txt).
RESUME_PATH="data/resume/resume.pdf"

# --- Booking: Google Calendar (real calendar, FREE) -------------------------
# One-time setup: create an OAuth client (Desktop) in Google Cloud Console,
# then run `npm run get-google-token` to mint a refresh token. See README.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
BOOKING_TIMEZONE="Asia/Kolkata"
BOOKING_DURATION_MIN="30"
BOOKING_WINDOW_DAYS="14"
# Working hours the agent is allowed to offer, local to BOOKING_TIMEZONE.
BOOKING_WORK_START="10:00"
BOOKING_WORK_END="18:00"
# Days of week bookable (0=Sun..6=Sat), comma-separated.
BOOKING_WORK_DAYS="1,2,3,4,5"
# Where to send confirmations (your email + invitee gets the calendar invite).
BOOKING_HOST_EMAIL=""

# --- Evals ------------------------------------------------------------------
# (JUDGE_MODEL is set above in the Groq section.)
# Optional, only if your eval harness pulls Vapi call logs via API.
VAPI_PRIVATE_KEY=""
VAPI_ASSISTANT_ID=""
