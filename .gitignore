# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — NEVER commit secrets
.env
.env*.local
.env.local

# secrets / credentials
*.credentials.json
google-credentials.json

# the actual resume PDF is private — keep it out of git, ship only the derived public corpus
/data/resume/*.pdf
/data/resume/*.docx

# eval run artifacts (kept out by default; commit a sample if you want)
/evals/results/*.json
!/evals/results/.gitkeep

# vercel
.vercel

# TypeScript incremental build cache
tsconfig.tsbuildinfo
